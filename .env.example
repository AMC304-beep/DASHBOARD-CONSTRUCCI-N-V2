# ─────────────────────────────────────────────────────────────────────────────
# IBM Construction Dashboard – Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: This file is listed in .gitignore and MUST NEVER be committed.
#            Use GitHub Secrets (Actions) or IBM Secrets Manager in production.
#            Copy this file to .env and fill in real values locally.
# ─────────────────────────────────────────────────────────────────────────────

# ── Monday.com API Token ──────────────────────────────────────────────────────
# Obtain from: Monday.com → Avatar → Developers → My Access Tokens → Show
# Required scope: me:write (for create/update/file operations)
# NEVER share this value or commit it to version control.
MONDAY_API_TOKEN=your_monday_api_token_here

# ── Server configuration ──────────────────────────────────────────────────────
# Host MUST remain 127.0.0.1 (localhost) per IBM IT security policy.
# Binding to 0.0.0.0 is strictly prohibited.
PORT=3000

# ── CORS allowed origins ──────────────────────────────────────────────────────
# Comma-separated list of origins permitted to call this backend.
# In production, set to your actual domain(s) only.
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
